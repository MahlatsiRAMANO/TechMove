@{
    ViewData["Title"] = "Access denied";
}
<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card mt-4">
            <div class="card-body p-4 text-center">
                <div class="display-6 mb-2">🔒</div>
                <h1 class="h4">You don't have access to that page</h1>
                <p class="text-muted">Your role (@(User.IsAdmin() ? "Admin" : User.IsEmployee() ? "Staff" : "Customer")) is not allowed to do this. Ask an administrator if you need more access.</p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to dashboard</a>
            </div>
        </div>
    </div>
</div>
