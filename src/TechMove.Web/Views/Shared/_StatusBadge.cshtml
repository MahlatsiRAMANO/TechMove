@model ContractStatus
@{
    var css = Model switch
    {
        ContractStatus.Active => "tm-badge-active",
        ContractStatus.Draft => "tm-badge-draft",
        ContractStatus.OnHold => "tm-badge-onhold",
        ContractStatus.Expired => "tm-badge-expired",
        _ => "bg-light text-dark"
    };
    var label = Model == ContractStatus.OnHold ? "On Hold" : Model.ToString();
}
<span class="badge @css">@label</span>
