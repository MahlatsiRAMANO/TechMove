@{
    ViewData["Title"] = "Service unavailable";
    var message = ViewData["Message"] as string ?? "The TechMove API is not responding.";
}
<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card mt-4">
            <div class="card-body p-4 text-center">
                <div class="display-6 mb-2">🔌</div>
                <h1 class="h4">We couldn't reach the TechMove service</h1>
                <p class="text-muted">@message</p>
                <p class="small text-muted">Your data is safe. The frontend is running, but the backend API did not answer. Please try again in a moment.</p>
                <a href="javascript:location.reload()" class="btn btn-primary">Try again</a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-link">Dashboard</a>
            </div>
        </div>
    </div>
</div>
