@model ServiceRequestCreateViewModel
@{
    ViewData["Title"] = "New service request";
}
<h1 class="h3 mb-3">New service request</h1>
<div class="row g-4">
    <div class="col-lg-7">
        @if (!Model.Contracts.Any())
        {
            <div class="alert alert-warning">
                There are no Draft or Active contracts that can take service requests.
                Expired and On Hold contracts are blocked by the workflow.
            </div>
        }
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="ContractId" class="form-label"></label>
                <select asp-for="ContractId" asp-items="Model.Contracts" class="form-select">
                    <option value="">-- Select a contract --</option>
                </select>
                <div class="form-text">Only Draft and Active contracts within their end date are listed.</div>
                <span asp-validation-for="ContractId" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" rows="3" class="form-control"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="CostUsd" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input asp-for="CostUsd" type="number" step="0.01" min="0" class="form-control" />
                </div>
                <span asp-validation-for="CostUsd" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary">Create request</button>
            <a asp-action="Index" class="btn btn-link">Cancel</a>
        </form>
    </div>
    <div class="col-lg-5">
        <div class="card" id="fxCard" data-rate-url="@Url.Action("ExchangeRate")">
            <div class="card-header">Live currency conversion</div>
            <div class="card-body">
                <div class="text-muted small">USD → ZAR rate</div>
                <div class="fs-5 fw-semibold" id="fxRate">Loading…</div>
                <hr />
                <div class="text-muted small">Estimated local cost</div>
                <div class="fs-3 fw-semibold" id="fxZar">R 0.00</div>
                <div class="form-text" id="fxNote">The final amount is recalculated on the server with the live rate when you save.</div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/service-request.js" asp-append-version="true"></script>
}
