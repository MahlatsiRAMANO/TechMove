@model IReadOnlyList<Client>
@{
    ViewData["Title"] = "Clients";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Clients</h1>
    <a class="btn btn-primary" asp-action="Create">Add client</a>
</div>

@if (Model.Count == 0)
{
    <p class="text-muted">No clients yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead><tr><th>Name</th><th>Contact details</th><th>Region</th><th class="text-end">Contracts</th><th></th></tr></thead>
            <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td><a asp-action="Details" asp-route-id="@c.Id">@c.Name</a></td>
                    <td>@c.ContactDetails</td>
                    <td>@c.Region</td>
                    <td class="text-end">@c.ContractCount</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@c.Id">Edit</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@c.Id">Delete</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
