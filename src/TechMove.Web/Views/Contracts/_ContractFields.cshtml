@model ContractFormViewModel
<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
<div class="mb-3">
    <label asp-for="ClientId" class="form-label"></label>
    <select asp-for="ClientId" asp-items="Model.Clients" class="form-select">
        <option value="">-- Select a client --</option>
    </select>
    <span asp-validation-for="ClientId" class="text-danger small"></span>
</div>
<div class="row">
    <div class="col-sm-6 mb-3">
        <label asp-for="StartDate" class="form-label"></label>
        <input asp-for="StartDate" type="date" class="form-control" />
        <span asp-validation-for="StartDate" class="text-danger small"></span>
    </div>
    <div class="col-sm-6 mb-3">
        <label asp-for="EndDate" class="form-label"></label>
        <input asp-for="EndDate" type="date" class="form-control" />
        <span asp-validation-for="EndDate" class="text-danger small"></span>
    </div>
</div>
<div class="row">
    <div class="col-sm-6 mb-3">
        <label asp-for="Status" class="form-label"></label>
        @if (Model.Id == 0)
        {
            <select asp-for="Status" asp-items="Model.StatusOptions" class="form-select"></select>
            <span asp-validation-for="Status" class="text-danger small"></span>
        }
        else
        {
            <input type="hidden" asp-for="Status" />
            <div class="form-control-plaintext"><partial name="_StatusBadge" model="Model.Status" /></div>
        }
    </div>
    <div class="col-sm-6 mb-3">
        <label asp-for="ServiceLevel" class="form-label"></label>
        <select asp-for="ServiceLevel" asp-items="Html.GetEnumSelectList<ServiceLevel>()" class="form-select"></select>
        <span asp-validation-for="ServiceLevel" class="text-danger small"></span>
    </div>
</div>
